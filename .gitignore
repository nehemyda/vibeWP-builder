# Dependencies
node_modules/

# Next.js build output
.next/
out/
build/

# Env files — never commit real credentials
.env
.env.*
!.env.local.example

# Keys and certs
*.pem
*.key
*.p12

# macOS
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# Guard: temp dir used when absorbing a nested repo
.git-absorb-tmp/

# Backup run log
backups/backup.log

# Subagent worktrees. Each is its own git repo; committing one embeds a
# repository inside this one.
.claude/worktrees/
app/.claude/worktrees/

# The plaintext dump. It holds every client's pages, leads and form
# submissions in the clear, and backup.sh now writes it OUTSIDE the repo —
# these rules are the second line, for a stray copy or an older checkout.
# The committed backup is backups/*.age, decryptable only with the private
# key, which is not on this machine.
backups/db-data.json
backups/db-data.sql
