# Supabase project settings — Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for Drizzle — Settings → Database → Connection string (URI, "Transaction" pooler)
DATABASE_URL=

# Optional — only needed to enable the "Continue with Google/GitHub" buttons.
# Configure these as OAuth providers in Supabase Auth settings too.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
NEXT_PUBLIC_GITHUB_OAUTH_ENABLED=false
