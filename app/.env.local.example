# Supabase project settings — Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for Drizzle — Settings → Database → Connection string (URI, "Transaction" pooler)
DATABASE_URL=

# Optional — only needed to enable the "Continue with Google/GitHub" buttons.
# Configure these as OAuth providers in Supabase Auth settings too.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
NEXT_PUBLIC_GITHUB_OAUTH_ENABLED=false

# Where Vibe sites are served: the wildcard host under which every published
# Vibe site gets a subdomain, e.g. "vibewp.app" serving acme.vibewp.app.
#
# Requires a wildcard DNS record and a wildcard certificate to already exist,
# which is why this is deployment config and not an admin setting. Leave it
# unset to turn platform hosting off entirely — publishing a Vibe site then
# refuses rather than handing out an address nothing answers on.
#
# Locally use "localhost": browsers resolve any *.localhost to the loopback,
# so http://acme.localhost:3000 reaches the dev server on any port.
VIBEWP_SITES_HOST=
